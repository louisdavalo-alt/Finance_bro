*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node (le frontend a aussi son propre .gitignore)
node_modules/

# Éditeurs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Journaux
*.log
