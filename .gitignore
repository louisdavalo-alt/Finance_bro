# Secrets et configuration locale — NE JAMAIS COMMITTER
.env
.env.*
!.env.example

# Données générées par le pipeline (base DuckDB, exports Parquet, caches, journaux)…
data/*
# …sauf les fichiers déposés à la main, nécessaires aux connecteurs BOJ, Tokyo, RBI et MOSPI
!data/manual/

# Python
.venv/
venv/
