# Copie ce fichier en ".env". Chaque bloc peut rester vide : la source correspondante
# est alors simplement désactivée (voir app/registry.py : enabled(settings)).

DATA_DIR=./data

# --- États-Unis : FRED (clé gratuite sur https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# --- Zone euro : BCE — aucune clé nécessaire

# --- France : FMI (SDMX 3.0)
# Remplace l'INSEE. Clé gratuite via le portail développeur du FMI (https://api.imf.org),
# transmise en en-tête Ocp-Apim-Subscription-Key. Seul le code CPI (FR_CPI) est confirmé par la
# spec officielle du FMI ; PIB et chômage restent sur la Banque mondiale en attendant un code
# confirmé (voir ARCHITECTURE.md, section FMI).
IMF_API_KEY=

# --- Allemagne / zone euro : yfinance (données de marché, pas de statistiques officielles)
# Aucune clé nécessaire. Voir app/connectors/yfin.py : bibliothèque non officielle, sujette à
# casser sans préavis si Yahoo change ses points d'accès internes.
YFINANCE_ENABLED=true

# --- Japon : e-Stat (clé gratuite sur https://www.e-stat.go.jp/mypage/user/preregister)
ESTAT_APP_ID=

# --- Japon : Banque du Japon — aucune clé nécessaire (API ouverte depuis février 2026)

# --- Chine : NBS — endpoint non officiel, désactivable si bloqué depuis ton serveur
NBS_CHINA_ENABLED=true

# --- Banque mondiale — aucune clé nécessaire

# --- Limites de requêtes (valeurs par défaut prudentes, à ajuster par source)
FRED_RATE_MAX=100
FRED_RATE_WINDOW=60
IMF_RATE_MAX=30
IMF_RATE_WINDOW=60
ECB_RATE_MAX=20
ECB_RATE_WINDOW=10
YFINANCE_RATE_MAX=30
YFINANCE_RATE_WINDOW=60
ESTAT_RATE_MAX=60
ESTAT_RATE_WINDOW=60
BOJ_RATE_MAX=20
BOJ_RATE_WINDOW=60
NBS_RATE_MAX=6
NBS_RATE_WINDOW=60
WB_RATE_MAX=30
WB_RATE_WINDOW=60

HTTP_TIMEOUT_S=20
HTTP_MAX_RETRIES=4

# --- API de consultation (app/serve.py)
# 127.0.0.1 = accessible uniquement depuis cette machine (recommandé).
HOST=127.0.0.1
PORT=8100

# --- Sécurité de l'API (voir README, section « Sécurité »)
# Authentification HTTP Basic : OBLIGATOIRE si HOST n'est pas 127.0.0.1 (le lancement est
# refusé sinon). Mot de passe de 12 caractères minimum, par ex. :
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
API_USERNAME=
API_PASSWORD=
# Noms d'hôte / IP acceptés dans l'en-tête Host, séparés par des virgules, EN PLUS de
# 127.0.0.1/localhost (protection DNS rebinding). Ex. : API_ALLOWED_HOSTS=macro.local,192.168.1.20
API_ALLOWED_HOSTS=
# Documentation interactive (/docs, /redoc, /openapi.json). Mettre false pour la masquer.
API_ENABLE_DOCS=true
# Calculs lourds simultanés (prévision, portefeuille, appels Yahoo) ; les suivants attendent.
API_MAX_CONCURRENT_JOBS=2
# Durée de vie (s) du cache mémoire des réponses Yahoo (cotation, graphiques) et des prévisions.
API_LIVE_CACHE_TTL_S=60
API_FORECAST_CACHE_TTL_S=900
# Anti force brute : N mots de passe faux par IP sur la fenêtre (s) => blocage temporaire (429).
API_AUTH_MAX_FAILURES=10
API_AUTH_FAILURE_WINDOW_S=300
# Nombre maximal de tickers ajoutés via « Ajouter à la bibliothèque active » (POST /market-activate).
API_MAX_CUSTOM_INDICATORS=200
# Connexions HTTP simultanées acceptées par uvicorn (au-delà : 503).
API_LIMIT_CONCURRENCY=64
# Délai minimal (s) entre deux resynchronisations Yahoo d'un même symbole quand le cache OHLCV
# n'a pas encore la barre du jour (week-end, jour férié, avant l'ouverture). 0 = à chaque appel.
OHLCV_MIN_RESYNC_S=900

# Les URL de base des sources (FRED_BASE_URL, etc.) doivent être en https:// — les clés API
# transitent dans les requêtes. ALLOW_INSECURE_HTTP=true lève ce contrôle (proxy local de test).

# --- Prévision Kronos (modèle de fondation auto-hébergé, optionnel) ---
# Laisser vide désactive entièrement l'option (masquée dans le dashboard). Voir
# deploy/kronos_patch.md pour le correctif à appliquer côté serveur Kronos, et README.md,
# section "Prévision Kronos". Adresse INTERNE (pas l'URL publique OAuth2 Proxy) :
# KRONOS_BASE_URL=http://127.0.0.1:3021
KRONOS_BASE_URL=
KRONOS_LOOKBACK=400
KRONOS_PRED_LEN=120
KRONOS_TEMPERATURE=1.0
KRONOS_TOP_P=0.9
KRONOS_SAMPLE_COUNT=1
KRONOS_TIMEOUT_S=180
